{
  "name": "slides",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/slides",
  "tags": ["scope:shared"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "slidev slides.md --port 3030 --open",
        "cwd": "apps/slides"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/slides"],
      "options": {
        "command": "slidev build slides.md --out ../../dist/apps/slides",
        "cwd": "apps/slides"
      }
    },
    "export": {
      "executor": "nx:run-commands",
      "options": {
        "command": "slidev export slides.md --output ../../dist/apps/slides.pdf",
        "cwd": "apps/slides"
      }
    }
  }
}
